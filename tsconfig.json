{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true
	},
	"exclude": ["node_modules", "apps", "packages"]
}
