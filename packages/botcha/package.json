{
	"name": "botcha",
	"version": "0.1.0",
	"description": "Bot authentication for AI agents — proves bot identity cryptographically",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run"
	},
	"dependencies": {
		"jose": "^6.1.3"
	},
	"devDependencies": {
		"tsup": "^8.3.5",
		"typescript": "^5",
		"vitest": "^3"
	}
}
